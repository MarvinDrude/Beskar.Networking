<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <Title>Beskar.Mqtt.Server</Title>
      <Description>High-performance, low-allocation MQTT broker/server support for v3.1.1 and v5.0 over any transport.</Description>
      <IsPackable>true</IsPackable>
   </PropertyGroup>

   <ItemGroup>
     <ProjectReference Include="..\Beskar.Mqtt.Client\Beskar.Mqtt.Client.csproj" />
     <ProjectReference Include="..\Beskar.Mqtt.Common\Beskar.Mqtt.Common.csproj" />
     <ProjectReference Include="..\Beskar.Mqtt.Protocol\Beskar.Mqtt.Protocol.csproj" />
     <ProjectReference Include="..\Beskar.Mqtt.Common.Generators\Beskar.Mqtt.Common.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
   </ItemGroup>
   
   <ItemGroup>
      <InternalsVisibleTo Include="Beskar.Mqtt.Common.Tests" />
   </ItemGroup>

   <PropertyGroup>
      <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzer</TargetsForTfmSpecificContentInPackage>
   </PropertyGroup>

   <Target Name="PackAnalyzer">
      <ItemGroup>
         <TfmSpecificPackageFile Include="..\Beskar.Mqtt.Common.Generators\bin\$(Configuration)\netstandard2.0\Beskar.Mqtt.Common.Generators.dll" PackagePath="analyzers/dotnet/cs" />
      </ItemGroup>
   </Target>

</Project>
